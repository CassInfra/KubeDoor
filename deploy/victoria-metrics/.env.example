# 复制为 .env 后修改：cp .env.example .env
# 这些参数只用于独立 VictoriaMetrics，不要复制到 deploy/kubedoor.conf。

# HTTP Basic Auth 账号和密码（都不能为空）。请替换示例密码。
# 密码含 $ 时用单引号包住，避免 Compose 将其当成变量展开。
VM_USER=monit
VM_PASSWORD='change-me'

# 数据保留时间，支持 d（天）、w（周）、y（年）等 VictoriaMetrics 单位。
VM_RETENTION=30d

# 对外监听地址和端口，需能从 KubeDoor 所在的 K8S 集群访问。
VM_BIND_ADDR=0.0.0.0
VM_PORT=8428

# 默认使用国内镜像仓库；需要其他镜像时再取消注释。
# VM_IMAGE=registry.cn-shenzhen.aliyuncs.com/starsl/victoria-metrics:stable
