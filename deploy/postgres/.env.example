# =============================================================================
# KubeDoor PostgreSQL 部署参数
# 复制为 .env 后修改:cp .env.example .env
#
# 改完记得把同样的 PG_USER / PG_PASSWORD / PG_DATABASE / PG_PORT
# 填到 deploy/kubedoor.conf 里,master 和 alarm 要用它连库。
# =============================================================================

# 数据库账号(首次启动时创建,后续修改本文件不会改已有账号)
PG_USER=kubedoor
PG_PASSWORD=change-me
PG_DATABASE=kubedoor

# 对外监听。只在本机跑 K8S 时可改成 127.0.0.1 收紧暴露面
PG_BIND_ADDR=0.0.0.0
PG_PORT=5432

# 共享内存,建议 >= shared_buffers。机器内存小可以调到 512mb
PG_SHM_SIZE=1gb

# 数据库镜像。默认是国内镜像仓库(只有 amd64);海外或 ARM 机器可改为官方的
# postgres:18-alpine。注意保持 18 大版本,不要用浮动的 alpine / latest 标签
# PG_IMAGE=postgres:18-alpine

TZ=Asia/Shanghai
