# KubeDoor 安装配置：复制为 kubedoor.conf 后填写，再执行 ./install.sh master。
# 内部运行默认值及 deploy/install.sh 顶部的镜像版本由脚本自动加载。
# 如需高级定制，在本文件追加同名配置即可覆盖。口令含 $ 等字符时请用单引号。
# kubedoor.conf 含口令，已被 Git 忽略；完整说明见 README.md。

# PostgreSQL：先启动 postgres/，也可使用已有数据库。地址须能从 K8S Pod 访问。
PG_HOST=""                     # 必填，不能使用 localhost / 127.0.0.1
PG_PORT="5432"
PG_USER="kubedoor"
PG_PASSWORD=""                 # 必填，与 postgres/.env 中一致
PG_DATABASE="kubedoor"

# 时序库：先启动 victoria-metrics/，也可使用已有 Prometheus / VictoriaMetrics。
# URL 中的账号、口令含特殊字符时需 URL 编码，例如 @ 写成 %40。
PROM_URL=""                    # 必填，例如 http://monit:<口令>@<VM主机IP>:8428
PROM_TYPE="Victoria-Metrics-Single" # 或 Prometheus / Victoria-Metrics-Cluster
# 网页安装 Agent 时各集群 vmagent 默认直连的写入地址（带账号口令）；单机 VM 在上述地址后加 /api/v1/write。
# 须能从各业务集群访问。使用已有采集链路、仅安装 Agent 时可留空；不能用查询地址代替完整写入地址。
METRICS_WRITE_URL=""

# 集群区分标签（重要）：这是指标标签的键名，KubeDoor 靠它查询各集群的监控数据。
# 全新部署保持默认；接入已有 Prometheus / VM 时，填指标中实际标识集群的键名，如 cluster。
# 例如 origin_prometheus="prod-k8s"：本项填 origin_prometheus，K8S_NAME 填 prod-k8s。
# master 和所有脚本 Agent 的 kubedoor.conf 必须使用相同键名；网页新安装的 Agent 自动继承 master。
# 键名只能含字母、数字、下划线，不能以数字开头；配置不一致会导致监控数据查不到。
PROM_K8S_TAG_KEY="origin_prometheus"

# Web 入口：目标集群需能访问 KUBEDOOR_EXTURL，用于网页安装 Agent 和告警链接。
WEB_NODEPORT=""                # 留空由 K8S 分配；指定时通常为 30000-32767
KUBEDOOR_EXTURL=""              # 例如 http://<节点IP>:<WEB_NODEPORT>

# 告警通知（IM 机器人）不在这里配置：装完后在控制台「系统管理 → 消息通知」填写，可以按集群单独配置，保存后立即生效。

# 首次创建账号时的口令（可选）；留空使用出厂口令，后续在网页修改。
# 管理员 kubedoor 出厂口令为 kubedoor；脚本 Agent 账号为 Up4biLko1dNh。
KUBEDOOR_INIT_ADMIN_PASSWORD=""
KUBEDOOR_INIT_AGENT_PASSWORD=""

# 仅脚本安装 Agent 时填写，执行 ./install.sh agent；网页安装无需填写本段。
K8S_NAME=""                    # 集群唯一标识，只能包含字母、数字、下划线、中划线
# ws://Up4biLko1dNh:<口令>@<Web主机>:<端口>，HTTPS 入口使用 wss://。
MASTER_WS="ws://Up4biLko1dNh:qCa22jDkfc9y@kubedoor-master.kubedoor"
REMOTE_WRITE_URL=""            # 启用采集时必填，须能从目标集群访问完整写入地址
